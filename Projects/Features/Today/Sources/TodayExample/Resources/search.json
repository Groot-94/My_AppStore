verageUserRatingForCurrentVersion":4.71088000000000040046188587439246475696563720703125, "languageCodesISO2A":["EN", "JA", "KO"], "fileSizeBytes":"564209664", "formattedPrice":"무료", "userRatingCountForCurrentVersion":463973, "trackContentRating":"4+", "sellerUrl":"http://service.kakaomobility.com/kakaot/", "releaseNotes":"[업데이트] \n여러 개선 내용을 반영하고 사용 중 오류도 함께 수정했어요.", "averageUserRating":4.71088000000000040046188587439246475696563720703125, "contentAdvisoryRating":"4+", "trackCensoredName":"카카오 T - 택시, 세차, 주차, 바이크, 항공, 퀵", 
